OPENAI_API_KEY=sk-...
# Optional: override the text model used for grading the OCR transcription
OPENAI_MODEL=gpt-4o

# MathPix credentials for handwriting/math OCR (https://mathpix.com/ -> Dashboard -> API Keys)
MATHPIX_APP_ID=your-app-id
MATHPIX_APP_KEY=your-app-key

# Postgres connection string for storing results (name, date/time, score, stars).
# Local: postgres://user:password@localhost:5432/matheapp
# Railway: add the Postgres plugin, it injects DATABASE_URL automatically.
DATABASE_URL=postgres://user:password@localhost:5432/matheapp

PORT=3000

# Login: der Admin-Account "Stefan" wird beim ersten Serverstart mit diesem Passwort angelegt
# (danach kann das Passwort ueber die Admin-Oberflaeche geaendert werden).
ADMIN_PASSWORD=change-me

# Geheimer Schluessel zum Signieren der Login-Session-Tokens - ein langer, zufaelliger String.
# Aendern invalidiert alle bestehenden Logins. Generieren z.B. mit: openssl rand -hex 32
SESSION_SECRET=change-me-too

# TEMPORAER, nur fuer die Payrexx-Kontovalidierung: deaktiviert den Login komplett, damit Payrexx
# die Webseite pruefen kann. NICHT dauerhaft aktiviert lassen - nach der Pruefung wieder entfernen!
AUTH_BYPASS=false

# Payrexx (https://www.payrexx.com/) fuer das CHF-1.-/Monat Abo (Uebungsmodus/Pruefungsmodus/
# Ergebnisse). PAYREXX_INSTANCE ist der Teil vor ".payrexx.com" deiner Payrexx-Installation,
# PAYREXX_API_SECRET findest du im Payrexx-Backend unter Konto > API. Ausserdem im Payrexx-
# Backend unter Settings > API einen Webhook (Content-Type "JSON") auf
# https://DEINE-DOMAIN/api/subscription/webhook konfigurieren.
PAYREXX_INSTANCE=your-instance-name
PAYREXX_API_SECRET=your-api-secret
